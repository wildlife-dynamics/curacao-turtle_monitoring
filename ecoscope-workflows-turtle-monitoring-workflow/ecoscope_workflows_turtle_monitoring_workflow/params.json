              "type": "null"
            }
          ],
          "title": "Custom Colors",
          "description": "Optional hex color list. Leave empty to use the palette above."
        }
      },
      "required": [],
      "type": "object",
      "title": "Color Map - Nesting Activity"
    },
    "nesting_over_time_chart": {
      "additionalProperties": false,
      "properties": {
