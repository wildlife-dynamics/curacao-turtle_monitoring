            {
              "$ref": "#/$defs/LineStyle"
            }
          ],
          "default": null,
          "title": "Line Kwargs",
          "description": "Line style settings",
          "ecoscope:advanced": true
        },
        "smoothing": {
          "allOf": [
            {
              "$ref": "#/$defs/SmoothingConfig"
            }
          ],
          "default": null,
          "title": "Smoothing",
          "description": "Configuration for line smoothing. When set, creates a smoothed line with original data point markers.",
          "ecoscope:advanced": true
        }
      },
      "required": [],
      "type": "object",
      "title": "Nesting Activity Over Time Chart"
    },
