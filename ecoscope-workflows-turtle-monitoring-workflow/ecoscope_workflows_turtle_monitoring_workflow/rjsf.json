{
  "properties": {
    "workflow_details": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Workflow Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Workflow Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "description": "Add information that will help to differentiate this workflow from another.",
      "title": "Workflow Details"
    },
    "er_client": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/EarthRangerConnection",
          "description": "Select one of your configured data sources.",
          "title": ""
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Data Source"
    },
    "time_range": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "description": "The start time",
          "format": "date-time",
          "title": "Since",
          "type": "string"
        },
        "until": {
          "description": "The end time",
          "format": "date-time",
          "title": "Until",
          "type": "string"
        },
        "timezone": {
          "$ref": "#/$defs/TimezoneInfo",
          "default": null,
          "title": "Timezone"
        }
      },
      "required": [
        "since",
        "until"
      ],
      "type": "object",
      "description": "Choose the period of time to analyze.",
      "title": "Time Range"
    },
    "report_template_path": {
      "additionalProperties": false,
      "properties": {
        "var": {
          "title": "Report Template Path",
          "type": "string",
          "description": "Path or URL to the .docx Jinja2 template used for the turtle monitoring report.",
          "default": "https://raw.githubusercontent.com/wildlife-dynamics/curacao-turtle_monitoring/main/resources/templates/turtle_monitoring_template.docx",
          "ecoscope:advanced": true
        }
      },
      "required": [
        "var"
      ],
      "type": "object",
      "title": "Report Template Path"
    },
    "base_maps": {
      "additionalProperties": false,
      "properties": {
        "base_maps": {
          "default": [
            {
              "url": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
              "opacity": 1,
              "max_zoom": 20,
              "min_zoom": 0
            },
            {
              "url": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
              "opacity": 0.5,
              "max_zoom": 20,
              "min_zoom": 0
            }
          ],
          "description": "Select tile layers to use as base layers in map outputs. The first layer in the list will be the bottommost layer displayed.",
          "ecoscope:advanced": true,
          "items": {
            "anyOf": [
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
                    "enum": [
                      "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1,
                    "minimum": 0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Open Street Map",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1,
                    "minimum": 0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Roadmap",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1,
                    "minimum": 0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Satellite",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1,
                    "minimum": 0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Terrain",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1,
                    "minimum": 0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "USGS Hillshade",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://example.tiles.com/{z}/{x}/{y}.png",
                    "description": "The URL of a publicly accessible tiled raster service.",
                    "pattern": "https?:\\/\\/(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}([-a-zA-Z0-9()@:%_\\+.~#?&//=\\{\\}]*)",
                    "title": "Custom Layer URL",
                    "type": "string"
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1,
                    "minimum": 0,
                    "title": "Custom Layer Opacity",
                    "type": "number"
                  },
                  "max_zoom": {
                    "default": 20,
                    "description": "Set the maximum zoom level to fetch tiles for.",
                    "title": "Custom Layer Max Zoom",
                    "type": "integer"
                  },
                  "min_zoom": {
                    "default": 0,
                    "description": "Set the minimum zoom level to fetch tiles for.",
                    "title": "Custom Layer Min Zoom",
                    "type": "integer"
                  }
                },
                "title": "Custom Layer (Advanced)",
                "type": "object"
              }
            ],
            "title": "Base Layer"
          },
          "title": " ",
          "type": "array"
        }
      },
      "type": "object",
      "required": [],
      "title": "Base Maps"
    },
    "chart_palette": {
      "additionalProperties": false,
      "properties": {
        "colormap": {
          "$ref": "#/$defs/QualitativeColormap",
          "default": "Set1",
          "description": "Choose a color palette. For low-cardinality data any palette works; for high-cardinality data use tab20, tab20b, or tab20c to reduce color repetition.",
          "title": "Colormap"
        },
        "custom_colors": {
          "default": [],
          "description": "Leave empty to use the palette above. When provided, these colors are applied instead.",
          "ecoscope:advanced": true,
          "items": {
            "type": "string"
          },
          "title": "Custom Colors",
          "type": "array"
        }
      },
      "type": "object",
      "required": [],
      "title": "Chart Colors"
    },
    "all_events": {
      "additionalProperties": false,
      "properties": {
        "event_states": {
          "default": null,
          "description": "Choose to analyze events with a certain state. If left empty, events of all states will be analyzed",
          "ecoscope:advanced": true,
          "items": {
            "type": "string",
            "oneOf": [
              {
                "const": "new",
                "title": "New"
              },
              {
                "const": "active",
                "title": "Active"
              },
              {
                "const": "resolved",
                "title": "Resolved"
              },
              {
                "const": "review",
                "title": "Review"
              }
            ]
          },
          "title": "Event State",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [],
      "type": "object",
      "title": "Fetch All Events"
    },
    "Nesting": {
      "type": "object",
      "description": "",
      "ecoscope:task_group": true,
      "properties": {
        "nesting_colormap": {
          "additionalProperties": false,
          "properties": {
            "colormap": {
              "$ref": "#/$defs/QualitativeColormap",
              "default": "Set1",
              "description": "Choose a color palette. For low-cardinality data any palette works; for high-cardinality data use tab20, tab20b, or tab20c to reduce color repetition.",
              "title": "Colormap"
            },
            "custom_colors": {
              "default": [],
              "description": "Leave empty to use the palette above. When provided, these colors are applied instead.",
              "items": {
                "type": "string"
              },
              "title": "Custom Colors",
              "type": "array"
            }
          },
          "required": [],
          "type": "object",
          "title": ""
        },
        "nesting_layer": {
          "additionalProperties": false,
          "properties": {
            "use_icons": {
              "default": false,
              "description": "Use EarthRanger SVG icons instead of scatter points. When enabled, overlapping icons are automatically clustered.",
              "ecoscope:advanced": true,
              "title": "Use Icons",
              "type": "boolean"
            },
            "scatter_radius": {
              "default": 5,
              "description": "Point radius in pixels. Only applies when icons are disabled.",
              "ecoscope:advanced": true,
              "maximum": 50,
              "minimum": 1,
              "title": "Scatter Radius",
              "type": "integer"
            },
            "scatter_opacity": {
              "default": 1.0,
              "description": "Point opacity (0\u20131). Only applies when icons are disabled.",
              "ecoscope:advanced": true,
              "maximum": 1.0,
              "minimum": 0.0,
              "title": "Scatter Opacity",
              "type": "number"
            },
            "stroked": {
              "default": false,
              "description": "Draw an outline around each point. Helps distinguish overlapping/adjacent points. Only applies when icons are disabled.",
              "ecoscope:advanced": true,
              "title": "Stroked",
              "type": "boolean"
            },
            "scatter_line_color": {
              "default": "#ffffff",
              "description": "Outline color (hex). Only applies when icons are disabled and stroked=True.",
              "ecoscope:advanced": true,
              "title": "Scatter Line Color",
              "type": "string"
            },
            "scatter_line_width": {
              "default": 1.0,
              "description": "Outline width in pixels. Only applies when icons are disabled and stroked=True.",
              "ecoscope:advanced": true,
              "maximum": 10.0,
              "minimum": 0.0,
              "title": "Scatter Line Width",
              "type": "number"
            },
            "icon_size": {
              "default": 32,
              "description": "Icon size in pixels. Only applies when icons are enabled.",
              "ecoscope:advanced": true,
              "maximum": 128,
              "minimum": 8,
              "title": "Icon Size",
              "type": "integer"
            },
            "tooltip_columns": {
              "default": [],
              "description": "Columns to show when hovering over a point. Leave empty to show all properties.",
              "items": {
                "type": "string"
              },
              "title": "Tooltip Columns",
              "type": "array",
              "ecoscope:advanced": true
            }
          },
          "required": [],
          "type": "object",
          "title": ""
        }
      }
    },
    "nesting_over_time_chart": {
      "additionalProperties": false,
      "properties": {
        "time_interval": {
          "default": "month",
          "description": "Group and bucket nesting events by this time period on the chart.",
          "title": "Time Interval",
          "type": "string",
          "oneOf": [
            {
              "const": "year",
              "title": "Year"
            },
            {
              "const": "month",
              "title": "Month"
            },
            {
              "const": "week",
              "title": "Week"
            },
            {
              "const": "day",
              "title": "Day"
            },
            {
              "const": "hour",
              "title": "Hour"
            }
          ]
        }
      },
      "required": [],
      "type": "object",
      "title": "Nesting Activity Over Time"
    },
    "Turtle-Related Events": {
      "type": "object",
      "description": "",
      "ecoscope:task_group": true,
      "properties": {
        "turtle_colormap": {
          "additionalProperties": false,
          "properties": {
            "colormap": {
              "$ref": "#/$defs/QualitativeColormap",
              "default": "Set1",
              "description": "Choose a color palette. For low-cardinality data any palette works; for high-cardinality data use tab20, tab20b, or tab20c to reduce color repetition.",
              "title": "Colormap"
            },
            "custom_colors": {
              "default": [],
              "description": "Leave empty to use the palette above. When provided, these colors are applied instead.",
              "items": {
                "type": "string"
              },
              "title": "Custom Colors",
              "type": "array"
            }
          },
          "required": [],
          "type": "object",
          "title": ""
        },
        "turtle_layer": {
          "additionalProperties": false,
          "properties": {
            "opacity": {
              "default": 1.0,
              "description": "Opacity of the layer, between 0 (transparent) and 1 (opaque).",
              "ecoscope:advanced": true,
              "maximum": 1.0,
              "minimum": 0.0,
              "title": "Opacity",
              "type": "number"
            },
            "get_radius": {
              "default": 5,
              "description": "Radius of each point, in the units specified by radius_units.",
              "ecoscope:advanced": true,
              "maximum": 200,
              "minimum": 1,
              "title": "Get Radius",
              "type": "integer"
            },
            "radius_units": {
              "default": "pixels",
              "description": "Units for get_radius. 'pixels' keeps a fixed screen size; 'meters' scales with zoom.",
              "ecoscope:advanced": true,
              "title": "Radius Units",
              "type": "string"
            },
            "radius_scale": {
              "default": 1.0,
              "description": "A global radius multiplier applied to all points.",
              "ecoscope:advanced": true,
              "minimum": 0.0,
              "title": "Radius Scale",
              "type": "number"
            },
            "radius_min_pixels": {
              "default": 0.0,
              "description": "Minimum point radius in pixels. Prevents points from becoming invisible at low zoom.",
              "ecoscope:advanced": true,
              "minimum": 0.0,
              "title": "Radius Min Pixels",
              "type": "number"
            },
            "radius_max_pixels": {
              "default": 20,
              "description": "Maximum point radius in pixels. Caps how large points grow when zoomed in.",
              "ecoscope:advanced": true,
              "title": "Radius Max Pixels",
              "type": "number"
            },
            "get_line_color": {
              "default": "#000000",
              "description": "Outline color as a CSS hex string (e.g. '#000000' for black). Only visible when stroked is enabled.",
              "ecoscope:advanced": true,
              "title": "Get Line Color",
              "type": "string"
            },
            "get_line_width": {
              "default": 1.0,
              "description": "Outline width in line_width_units. Takes effect when stroked=true.",
              "ecoscope:advanced": true,
              "minimum": 0.0,
              "title": "Get Line Width",
              "type": "number"
            },
            "line_width_units": {
              "default": "pixels",
              "description": "Units for get_line_width. 'pixels' keeps a fixed screen width; 'meters' scales with zoom.",
              "ecoscope:advanced": true,
              "title": "Line Width Units",
              "type": "string"
            },
            "line_width_scale": {
              "default": 1.0,
              "description": "A global line width multiplier applied to all outlines.",
              "ecoscope:advanced": true,
              "minimum": 0.0,
              "title": "Line Width Scale",
              "type": "number"
            },
            "line_width_min_pixels": {
              "default": 0.0,
              "description": "Minimum outline width in pixels.",
              "ecoscope:advanced": true,
              "minimum": 0.0,
              "title": "Line Width Min Pixels",
              "type": "number"
            },
            "line_width_max_pixels": {
              "default": 2,
              "description": "Maximum outline width in pixels. Caps how wide the stroke grows at high zoom.",
              "ecoscope:advanced": true,
              "title": "Line Width Max Pixels",
              "type": "number"
            },
            "tooltip_columns": {
              "default": [],
              "description": "Columns to show when hovering over a point. Leave empty to show all properties.",
              "items": {
                "type": "string"
              },
              "title": "Tooltip Columns",
              "type": "array",
              "ecoscope:advanced": true
            },
            "filled": {
              "default": true,
              "description": "Fill each object with the assigned color.",
              "ecoscope:advanced": true,
              "title": "Filled",
              "type": "boolean"
            },
            "stroked": {
              "default": false,
              "description": "Draw an outline around each point. Configure color and width with get_line_color and get_line_width.",
              "ecoscope:advanced": true,
              "title": "Stroked",
              "type": "boolean"
            },
            "billboard": {
              "default": false,
              "description": "If true, points always face the camera regardless of map tilt.",
              "ecoscope:advanced": true,
              "title": "Billboard",
              "type": "boolean"
            },
            "auto_highlight": {
              "default": false,
              "description": "Highlight the point under the cursor when hovering.",
              "ecoscope:advanced": true,
              "title": "Auto Highlight",
              "type": "boolean"
            },
            "pickable": {
              "default": true,
              "description": "Allow points to respond to pointer and touch events.",
              "ecoscope:advanced": true,
              "title": "Pickable",
              "type": "boolean"
            }
          },
          "required": [],
          "type": "object",
          "title": ""
        }
      }
    }
  },
  "$defs": {
    "EarthRangerConnection": {
      "properties": {
        "name": {
          "title": "Data Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "EarthRangerConnection",
      "type": "object"
    },
    "TimezoneInfo": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tzCode": {
          "title": "Tzcode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "utc": {
          "title": "Utc",
          "type": "string"
        }
      },
      "required": [
        "label",
        "tzCode",
        "name",
        "utc"
      ],
      "title": "TimezoneInfo",
      "type": "object"
    },
    "QualitativeColormap": {
      "enum": [
        "Pastel1",
        "Pastel2",
        "Paired",
        "Accent",
        "Dark2",
        "Set1",
        "Set2",
        "Set3",
        "tab10",
        "tab20",
        "tab20b",
        "tab20c"
      ],
      "title": "QualitativeColormap",
      "type": "string"
    }
  },
